+#!/bin/bash
+
+# Arguments check
+if [ -z "$1" ]; then
+    echo ""
+    echo "Usage: sh $0 <moniker>"
+    echo ""
+    exit 1
+fi
+
+cat <<"EOF"
+
+  /$$$$$$                                          /$$                 /$$         /$$       
+ /$$__  $$                                        |__/                | $$       /$$$$       
+| $$  \__/  /$$$$$$  /$$$$$$$   /$$$$$$   /$$$$$$$ /$$  /$$$$$$$      | $$      |_  $$       
+| $$ /$$$$ /$$__  $$| $$__  $$ /$$__  $$ /$$_____/| $$ /$$_____/      | $$        | $$       
+| $$|_  $$| $$$$$$$$| $$  \ $$| $$$$$$$$|  $$$$$$ | $$|  $$$$$$       | $$        | $$       
+| $$  \ $$| $$_____/| $$  | $$| $$_____/ \____  $$| $$ \____  $$      | $$        | $$       
